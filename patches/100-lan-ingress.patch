+++ b/internal/pep/lan_ingress.go
@@ -0,0 +1,74 @@
+package pep
+
+import (
+	"errors"
+	"net"
+	"net/netip"
+	"strconv"
+	"strings"
+)
+
+func lanPrefixes(name string) ([]netip.Prefix, error) {
+	if len(name) == 0 || len(name) > 15 || strings.ContainsAny(name, "/\\ \t\r\n") {
+		return nil, errors.New("invalid SOCKS LAN interface")
+	}
+	iface, err := net.InterfaceByName(name)
+	if err != nil || iface.Flags&net.FlagUp == 0 || iface.Flags&(net.FlagLoopback|net.FlagPointToPoint) != 0 {
+		return nil, errors.New("SOCKS LAN interface must be an active non-loopback LAN device")
+	}
+	addresses, err := iface.Addrs()
+	if err != nil || len(addresses) > 64 {
+		return nil, errors.New("cannot enumerate bounded SOCKS LAN addresses")
+	}
+	prefixes := []netip.Prefix{}
+	for _, address := range addresses {
+		prefix, err := netip.ParsePrefix(address.String())
+		if err == nil && prefix.Addr().Is4() && !prefix.Addr().IsLoopback() && !prefix.Addr().IsUnspecified() && !prefix.Addr().IsMulticast() && !prefix.Addr().IsLinkLocalUnicast() {
+			prefixes = append(prefixes, prefix)
+		}
+	}
+	if len(prefixes) == 0 {
+		return nil, errors.New("SOCKS LAN interface has no usable IPv4 addresses")
+	}
+	return prefixes, nil
+}
+
+func validateLANListener(address, iface string) error {
+	host, port, err := net.SplitHostPort(address)
+	ip := net.ParseIP(host)
+	number, portErr := strconv.Atoi(port)
+	if err != nil || ip == nil || ip.To4() == nil || !ip.IsUnspecified() || portErr != nil || number < 1 || number > 65535 {
+		return errors.New("SOCKS LAN mode requires --listen 0.0.0.0:PORT with a nonzero port")
+	}
+	_, err = lanPrefixes(iface)
+	return err
+}
+
+// A wildcard socket accepts localhost and connections addressed to the named
+// LAN device from one of its IPv4 subnets. WAN destination addresses and peers
+// outside those subnets are rejected before SOCKS parsing or session admission.
+func allowLANConnection(iface string, conn net.Conn) bool {
+	local, localOK := conn.LocalAddr().(*net.TCPAddr)
+	peer, peerOK := conn.RemoteAddr().(*net.TCPAddr)
+	if !localOK || !peerOK {
+		return false
+	}
+	if local.IP.IsLoopback() && peer.IP.IsLoopback() {
+		return true
+	}
+	localIP, localOK := netip.AddrFromSlice(local.IP)
+	peerIP, peerOK := netip.AddrFromSlice(peer.IP)
+	if !localOK || !peerOK || !localIP.Unmap().Is4() || !peerIP.Unmap().Is4() {
+		return false
+	}
+	prefixes, err := lanPrefixes(iface)
+	if err != nil {
+		return false
+	}
+	for _, prefix := range prefixes {
+		if prefix.Addr() == localIP.Unmap() && prefix.Contains(peerIP.Unmap()) {
+			return true
+		}
+	}
+	return false
+}
